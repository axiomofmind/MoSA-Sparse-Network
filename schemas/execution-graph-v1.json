{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparse-network.local/schemas/execution-graph-v1.json",
  "title": "Sparse Network Execution Graph v1",
  "type": "object",
  "required": ["schema", "graph_id", "mode", "bounded", "nodes"],
  "properties": {
    "schema": { "const": "sparse-network-execution-graph.v1" },
    "graph_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["top-1", "top-2", "mosa"] },
    "bounded": { "const": true },
    "maximum_nodes": { "type": "integer", "minimum": 1 },
    "nodes": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
